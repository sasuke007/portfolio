# Copy this file to `.env.local` and fill in values.
# `.env.local` is gitignored — never commit real secrets.
#
# All variables are SERVER-ONLY. None are exposed to the browser.
# Missing variables cause the corresponding navbar pill to simply
# not render — the site still works without any of them set.

# ─── Spotify ────────────────────────────────────────────────────────────
# Used by /api/now-playing. Get these from
# https://developer.spotify.com/dashboard — create an app, then run the
# Authorization Code flow once to obtain a refresh token.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# ─── X (Twitter) ────────────────────────────────────────────────────────
# Used by /api/x/latest. App-Only authentication; Bearer token never
# expires. Get it from https://developer.x.com.
X_BEARER_TOKEN=
X_USER_ID=
X_HANDLE=

# ─── GitHub ─────────────────────────────────────────────────────────────
# Used by /api/github/latest. A fine-grained personal access token with
# read-only public-repo access is sufficient. Create one at
# https://github.com/settings/tokens?type=beta.
GITHUB_TOKEN=
GITHUB_USERNAME=

# ─── Postgres playground ────────────────────────────────────────────────
# Used by the interactive isolation-level playground embedded in the
# /blog/database/isolation-levels post.
#
# Admin connection (used for schema bootstrap + session bookkeeping).
# UNPOOLED — the -pooler hostname uses PgBouncer transaction-mode which
# breaks `BEGIN; SET TRANSACTION ISOLATION LEVEL ...` sequences.
DATABASE_URL_UNPOOLED=

# Executor connection (used for every piece of user-issued SQL).
# Built from the playground_login role created by
# scripts/playground-bootstrap.sql.
PLAYGROUND_EXECUTOR_URL=

# HMAC secret used to sign the session cookie (`pgp_sid`). 32+ random bytes.
# Generate with: `openssl rand -base64 48`
PLAYGROUND_SESSION_SECRET=

# Bearer token for the cleanup cron at /api/playground/cleanup.
# Vercel Cron sends this in the Authorization header.
CRON_SECRET=

# Upstash Redis (Vercel Marketplace) — used for per-IP and per-session
# rate limits. Auto-injected when the integration is installed via:
#   vercel install upstash/upstash-kv
# The Marketplace names these KV_REST_API_*; the playground's rate
# limiter reads either naming scheme.
KV_REST_API_URL=
KV_REST_API_TOKEN=
