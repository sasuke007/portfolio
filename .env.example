# Copy this file to `.env.local` and fill in values.
# `.env.local` is gitignored — never commit real secrets.
#
# All variables are SERVER-ONLY. None are exposed to the browser.
# Missing variables cause the corresponding navbar pill to simply
# not render — the site still works without any of them set.

# ─── Spotify ────────────────────────────────────────────────────────────
# Used by /api/now-playing. Get these from
# https://developer.spotify.com/dashboard — create an app, then run the
# Authorization Code flow once to obtain a refresh token.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# ─── X (Twitter) ────────────────────────────────────────────────────────
# Used by /api/x/latest. App-Only authentication; Bearer token never
# expires. Get it from https://developer.x.com.
X_BEARER_TOKEN=
X_USER_ID=
X_HANDLE=

# ─── GitHub ─────────────────────────────────────────────────────────────
# Used by /api/github/latest. A fine-grained personal access token with
# read-only public-repo access is sufficient. Create one at
# https://github.com/settings/tokens?type=beta.
GITHUB_TOKEN=
GITHUB_USERNAME=
